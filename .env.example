# Default deterministic planner is completely offline. No API key needed.
AGENT_PLANNER=deterministic
# Enable only when explicitly testing with your own account and synthetic examples:
# AGENT_PLANNER=llm
# OPENAI_API_KEY=YOUR_KEY_HERE
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# For repeatable local runs leave the DB at the default, or specify:
# AGENT_OPS_DB=./demo.sqlite3
